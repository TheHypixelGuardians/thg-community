DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_TOKEN=your_discord_token_here

# Database Configuration (if needed)
DATABASE_URL=your_database_url_here

# Important Channels & Other features
ERROR_LOG_CHANNEL_ID=channel_id_here
# General log channel: account links, link-role sync, repost warnings.
# A per-server value set in the database takes precedence over this.
LOG_CHANNEL_ID=channel_id_here

# Optional APIs
HYPIXEL_API_KEY=your_hypixel_api_key
SHEETDB_API_URL=your_sheetdb_url
SHEETDB_API_KEY=your_sheetdb_api_key

# Environment
NODE_ENV=development
