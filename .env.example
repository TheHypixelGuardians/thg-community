DISCORD_TOKEN=your_discord_token_here

# Database Configuration (if needed)
DATABASE_URL=your_database_url_here

# Important Channels & Other features
ERROR_LOG_CHANNEL_ID=channel_id_here
# General log channel: account links and warnings.
# A per-server value set in the database takes precedence over this.
LOG_CHANNEL_ID=channel_id_here

# Optional APIs
HYPIXEL_API_KEY=your_hypixel_api_key

# The Discord user id /pingdiamond pings
PINGDIAMOND_USER_ID=

# /link verification server: on only when both are set.
# The port it listens on, and the address members are told to join.
VERIFY_SERVER_PORT=
VERIFY_SERVER_ADDRESS=

# Environment
NODE_ENV=development
