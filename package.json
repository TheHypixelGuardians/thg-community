{
  "name": "thg-community",
  "version": "0.0.1-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "setup:prod": "yarn --omit=dev && yarn prisma:generate && yarn prisma:push",
    "setup": "yarn && yarn prisma:generate && yarn prisma:push",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "build": "tsc",
    "dev": "tsx src/dev.ts",
    "watch": "nodemon --ext ts,js,mjs,cjs,json --exec yarn dev",
    "biome:fix": "biome check --write . && biome format --write .",
    "start": "node build/main.js",
    "start:prod": "tsc && node build/main.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "dependencies": {
    "@discordx/importer": "^1.3.3",
    "@discordx/utilities": "^8.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "chokidar": "^5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=7.0.0"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
