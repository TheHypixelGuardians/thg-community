{
  "name": "thg-community",
  "version": "0.0.1-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "prepare": "node scripts/setup-hooks.cjs",
    "setup:prod": "yarn --omit=dev && yarn prisma:generate && yarn prisma:migrate",
    "setup": "yarn && yarn prisma:generate && yarn prisma:migrate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:baseline": "prisma migrate resolve --applied 0_init",
    "legacy:import": "tsx scripts/import-legacy.ts",
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && prisma generate && tsc",
    "dev": "tsx src/dev.ts",
    "watch": "nodemon --ext ts,js,mjs,cjs,json --exec yarn dev",
    "biome:fix": "biome check --write . && biome format --write .",
    "start": "node build/main.js",
    "start:prod": "yarn build && node build/main.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "dependencies": {
    "@discordx/importer": "^1.3.3",
    "@discordx/utilities": "^8.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "dotenv": "^17.4.2",
    "minecraft-protocol": "^1.68.0",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "skyhelper-networth": "^2.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "chokidar": "^5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=7.0.0"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
