// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  discordId String   @unique
  username  String
  language  String   @default("nl")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  minecraftLink   MinecraftLink?
  featureRequests FeatureRequest[]
}

model Setup {
  id                 Int      @id @default(autoincrement())
  guildId            String   @unique
  ticketChannelId    String?  @default("")
  ticketCategoryId   String?  @default("")
  ticketStaffRoleId  String?  @default("")
  ticketLogChannelId String?  @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  automodEnabled           Boolean  @default(false)
  automodChannelId         String?  @default("")
  automodRoleId            String?  @default("")
  automodChannelExceptions String[] @default([])
  automodRoleExceptions    String[] @default([])

  /// Role handed to members who link a Minecraft account. Null turns the
  /// feature off; changing or clearing it never strips the old role.
  linkRoleId       String?
  /// Where `/request` submissions are posted.
  requestChannelId String?
  /// Where disguised messages and admin-panel actions are recorded.
  auditChannelId   String?
  /// General bot log channel — account links, link-role sync, repost warnings.
  logChannelId     String?
}

/// A Discord user's Minecraft account.
///
/// Owned by this bot, but read by TriBridge: the bridge attributes guild chat
/// to the Minecraft name and reposts linked users under their Minecraft head,
/// so this table is the single source of truth for Minecraft identity across
/// both bots. Related to `User.id` rather than to the Discord id, per the
/// schema conventions — TriBridge joins through `User`.
model MinecraftLink {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Mojang UUID, undashed. Avatar URLs use it, so a link survives a rename.
  uuid      String   @unique
  /// Canonical Minecraft name, as Mojang spells it.
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// A Discord role that counts as bot-admin.
///
/// Shared with TriBridge, which reads it to gate its own admin commands. Both
/// bots must agree about who is staff, so there is exactly one list.
model AdminRole {
  id        String   @id @default(uuid())
  guildId   String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleId])
  @@index([guildId])
}

/// A member-submitted feature request.
///
/// `id` is the number members see. It is a database sequence rather than a
/// counter read-modify-written by the bot, which is what stops two concurrent
/// submissions sharing a number.
model FeatureRequest {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  /// pending | planned | accepted | denied | duplicate
  status      String   @default("pending")
  /// Where the request was posted. Kept per record rather than read from the
  /// current configuration, so requests posted before a `/requestchannel set`
  /// still edit in place.
  channelId   String?
  messageId   String?
  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId])
  @@index([status])
}

/// The running global profile change, per Discord server.
///
/// One row per server, created on demand. `mode = "off"` is the resting state;
/// the tester and channel lists survive it so the next run does not have to be
/// set up from scratch. TriBridge reads this row to disguise its two bridge
/// legs and never writes it.
model GlobalProfileEffect {
  id                  String    @id @default(uuid())
  guildId             String    @unique
  /// off | test | live
  mode                String    @default("off")
  targetUserId        String?
  targetName          String?
  targetAvatarUrl     String?
  targetMcName        String?
  targetMcUuid        String?
  startedById         String?
  startedAt           DateTime?
  /// Null while an effect runs means "until somebody stops it".
  expiresAt           DateTime?
  testerIds           String[]  @default([])
  testChannelIds      String[]  @default([])
  excludedChannelIds  String[]  @default([])
  disguiseToMinecraft Boolean   @default(true)
  disguiseToDiscord   Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// A channel TriBridge owns, published by TriBridge at startup.
///
/// Written by the bridge, read here: the disguise must not repost in the bridge
/// channel (TriBridge does its own repost there) or in an officer channel (the
/// officer relay drops anything a bot authored, so a repost would lose the
/// message with no error anywhere). Publishing the ids instead of duplicating
/// them in this bot's configuration is what stops the two drifting apart when a
/// guild's officer channel changes.
model BridgeChannel {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  /// bridge | officer
  kind      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
}
