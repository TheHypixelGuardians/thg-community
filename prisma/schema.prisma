// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Node's ESM resolver needs the extension once tsc has compiled the client into build/
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  discordId String   @unique
  username  String
  language  String   @default("nl")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  minecraftLink   MinecraftLink?
  featureRequests FeatureRequest[]
}

model Setup {
  id                 Int      @id @default(autoincrement())
  guildId            String   @unique
  ticketChannelId    String?  @default("")
  ticketCategoryId   String?  @default("")
  ticketStaffRoleId  String?  @default("")
  ticketLogChannelId String?  @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  automodEnabled           Boolean  @default(false)
  automodChannelId         String?  @default("")
  automodRoleId            String?  @default("")
  automodChannelExceptions String[] @default([])
  automodRoleExceptions    String[] @default([])

  /// No longer read: the bot hands out no link role since roles were left to
  /// other bots. Kept so dropping it needs no migration that destroys data.
  linkRoleId       String?
  /// Where `/request` submissions are posted.
  requestChannelId String?
  /// General bot log channel — account links and warnings.
  logChannelId     String?
}

/// A Discord user's Minecraft account.
///
/// Owned by this bot, but read by TriBridge: the bridge attributes guild chat
/// to the Minecraft name and reposts linked users under their Minecraft head,
/// so this table is the single source of truth for Minecraft identity across
/// both bots. Related to `User.id` rather than to the Discord id, per the
/// schema conventions — TriBridge joins through `User`.
model MinecraftLink {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Mojang UUID, undashed. Avatar URLs use it, so a link survives a rename.
  uuid      String   @unique
  /// Canonical Minecraft name, as Mojang spells it.
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// A Discord role that counts as bot-admin.
///
/// Shared with TriBridge, which reads it to gate its own admin commands. Both
/// bots must agree about who is staff, so there is exactly one list.
model AdminRole {
  id        String   @id @default(uuid())
  guildId   String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleId])
  @@index([guildId])
}

/// A member-submitted feature request.
///
/// `id` is the number members see. It is a database sequence rather than a
/// counter read-modify-written by the bot, which is what stops two concurrent
/// submissions sharing a number.
model FeatureRequest {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  /// pending | planned | accepted | denied | duplicate
  status      String   @default("pending")
  /// Where the request was posted. Kept per record rather than read from the
  /// current configuration, so requests posted before a `/requestchannel set`
  /// still edit in place.
  channelId   String?
  messageId   String?
  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId])
  @@index([status])
}

/// A Discord user barred from every command of both bots, and from having
/// their Discord messages relayed into Minecraft by TriBridge.
///
/// **Written by TriBridge** (`/blacklist`), the one table the bridge writes,
/// and read by both bots. Defined here because this bot owns the schema and
/// its migrations. Keyed on the Discord id rather than `User.id`: a member can
/// be blacklisted before they have ever used this bot, and so before they have
/// a `User` row.
///
/// `id` and `updatedAt` have database-side defaults because TriBridge inserts
/// with plain SQL, where Prisma's client-side `uuid()` and `@updatedAt` never
/// run.
model Blacklist {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  /// Discord server id.
  guildId   String
  /// The blacklisted member's Discord id.
  discordId String
  reason    String?
  /// Discord id of the admin who added the entry.
  addedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([guildId, discordId])
  @@index([guildId])
}
